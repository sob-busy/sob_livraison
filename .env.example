# Modèle des variables d'environnement — Sob Livraison
# 1. Copiez ce fichier et renommez la copie en .env.local
# 2. Remplissez les valeurs dans .env.local (jamais dans ce fichier)
# .env.local n'est jamais envoyé sur GitHub.

# --- Supabase (Phase 2) ---
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET : utilisée uniquement côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# --- openrouteservice (Phase 2) ---
# SECRET : https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# --- Resend, emails de commande (Phase 2) ---
# SECRET : https://resend.com/api-keys
RESEND_API_KEY=
# Adresse d'expédition, ex : Sob Livraison <commandes@votre-domaine.com>
EMAIL_FROM=

# --- Site ---
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact (informations publiques) ---
# Numéro WhatsApp au format international, sans + ni espaces
NEXT_PUBLIC_WHATSAPP_NUMBER=22892889112
NEXT_PUBLIC_CONTACT_EMAIL=salaousobour@gmail.com
